generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OccupationDOT {
  id             String   @id
  title          String
  industryDesig  String?
  svp            Int
  strength       String
  gedR           Int
  gedM           Int
  gedL           Int
  aptitudes      Json
  temperaments   String[]
  interests      String[]
  physicalDemands Json
  envConditions  Json
  workFields     String[]
  mpsms          String[]
  dlu            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  crosswalks       DOTONETCrosswalk[]
  pastRelevantWork PastRelevantWork[]
}

model OccupationONET {
  id             String   @id
  title          String
  description    String?
  tasks          Json?
  dwas           Json?
  toolsTech      Json?
  knowledge      Json?
  skills         Json?
  abilities      Json?
  workActivities Json?
  workContext    Json?
  jobZone        Int?
  svpRange       String?
  relatedOccs    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  crosswalks      DOTONETCrosswalk[]
  targetOccs      TargetOccupation[]
}

model OccupationORS {
  id             String   @id @default(cuid())
  onetSocCode    String   @unique
  title          String
  physicalDemands Json?
  envConditions  Json?
  cogMental      Json?
  eduTrainExp    Json?
  standardErrors Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OccupationWages {
  id          String   @id @default(cuid())
  onetSocCode String
  areaType    String
  areaCode    String
  areaName    String
  employment  Int?
  meanWage    Float?
  medianWage  Float?
  pct10       Float?
  pct25       Float?
  pct75       Float?
  pct90           Float?
  rseEmployment   Float?  // BLS Relative Standard Error for employment estimate
  rseMedianWage   Float?  // RSE for median wage estimate
  rseMeanWage     Float?  // RSE for mean wage estimate
  year            Int
  createdAt       DateTime @default(now())

  @@unique([onetSocCode, areaType, areaCode, year])
  @@index([onetSocCode])
}

model OccupationProjections {
  id             String   @id @default(cuid())
  socCode        String
  title          String
  baseYear       Int
  projYear       Int
  baseEmployment Float?
  projEmployment Float?
  changeN        Float?
  changePct      Float?
  openingsAnnual Float?
  createdAt      DateTime @default(now())

  @@unique([socCode, baseYear, projYear])
}

model JOLTSIndustryData {
  id           String   @id @default(cuid())
  naicsCode    String
  industryName String
  year         Int
  jobOpenings  Float?   // thousands
  hires        Float?   // thousands
  createdAt    DateTime @default(now())

  @@unique([naicsCode, year])
}

model JOLTSStateData {
  id          String   @id @default(cuid())
  stateCode   String   // FIPS code: "01"-"56" or region "NE","MW","SO","WE"
  stateName   String
  year        Int
  jobOpenings Float?   // thousands
  hires       Float?   // thousands
  createdAt   DateTime @default(now())

  @@unique([stateCode, year])
}

model DOTONETCrosswalk {
  id          String @id @default(cuid())
  dotCode     String
  onetSocCode String

  dotOcc  OccupationDOT  @relation(fields: [dotCode], references: [id])
  onetOcc OccupationONET @relation(fields: [onetSocCode], references: [id])

  @@unique([dotCode, onetSocCode])
}

model Case {
  id             String    @id @default(cuid())
  clientName     String
  clientDOB      DateTime?
  evaluatorName  String?
  referralSource String?
  dateOfInjury   DateTime?
  dateOfEval     DateTime?
  zipCode        String?
  metroAreaCode  String?
  metroAreaName  String?
  notes          String?
  status         String    @default("active")

  // Injury & Medical Context
  injuryDescription  String?
  bodyPartsAffected  String[]
  treatingPhysician  String?
  physicianSpecialty String?
  mmiDate            DateTime?
  fceDate            DateTime?
  fceProvider        String?
  surgeryDates       String?
  medicalNotes       String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profiles         WorkerProfile[]
  pastRelevantWork PastRelevantWork[]
  acquiredSkills   AcquiredSkill[]
  analyses         Analysis[]
}

model WorkerProfile {
  id          String @id @default(cuid())
  caseId      String
  profileType String

  reasoning           Int?
  math                Int?
  language            Int?
  spatialPerception   Int?
  formPerception      Int?
  clericalPerception  Int?
  motorCoordination   Int?
  fingerDexterity     Int?
  manualDexterity     Int?
  eyeHandFoot         Int?
  colorDiscrimination Int?
  strength            Int?
  climbBalance        Int?
  stoopKneel          Int?
  reachHandle         Int?
  talkHear            Int?
  see                 Int?
  workLocation        Int?
  extremeCold         Int?
  extremeHeat         Int?
  wetnessHumidity     Int?
  noiseVibration      Int?
  hazards             Int?
  dustsFumes          Int?

  notes        String?
  sources      String?
  traitSources Json?     // Record<string, { source: string, date?: string, notes?: string }>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, profileType])
}

model PastRelevantWork {
  id                   String    @id @default(cuid())
  caseId               String
  jobTitle             String
  employer             String?
  dotCode              String?
  onetSocCode          String?
  svp                  Int?
  skillLevel           String?
  strengthLevel        String?
  startDate            DateTime?
  endDate              DateTime?
  durationMonths       Int?
  dutiesDescription    String?
  isSubstantialGainful Boolean   @default(true)
  actualWageHourly     Float?    // What the worker actually earned per hour
  actualWageAnnual     Float?    // What the worker actually earned annually
  wageYear             Int?      // Year of the reported wage
  hoursPerWeek         Float?    // Hours worked per week (for hourly->annual conversion)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  case           Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  dotOcc         OccupationDOT? @relation(fields: [dotCode], references: [id])
  acquiredSkills AcquiredSkill[]

  @@index([caseId])
  @@index([onetSocCode])
}

model AcquiredSkill {
  id                String  @id @default(cuid())
  caseId            String
  prwId             String
  actionVerb        String
  object            String
  context           String?
  toolsSoftware     String?
  materialsServices String?
  svpLevel          Int?
  evidenceSource    String?
  frequency         String?
  recency           String?
  performanceMode   String?
  isTransferable    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  prw  PastRelevantWork @relation(fields: [prwId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([prwId])
}

model Analysis {
  id             String   @id @default(cuid())
  caseId         String
  name           String?
  status         String   @default("draft")
  step           Int      @default(1)
  ageRule        String?
  analysisMode   String?  @default("strict") // "strict" (SSA/litigation) or "clinical" (rehabilitation)
  priorEarnings  Float?
  targetArea     String?
  targetAreaName String?
  dataVersions   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preInjuryViableCount     Int?
  preInjuryTotalEmployment Float?
  preInjuryJoltsOpenings   Float?
  postInjuryViableCount    Int?
  postInjuryTotalEmployment Float?
  postInjuryJoltsOpenings  Float?

  // ─── Area-Level Employment Aggregates ──────────────────────
  preInjuryAreaEmployment  Float?  // sum of area employment for pre-injury viable occs
  postInjuryAreaEmployment Float?  // sum of area employment for post-injury viable occs
  stateJoltsCurrent        Float?  // state-level JOLTS openings (current year)
  stateJoltsPreInjury      Float?  // state-level JOLTS openings (injury year)
  stateFips                String? // state FIPS code used for JOLTS lookup
  stateName                String? // state name

  // ─── VQS Earning Capacity Aggregates ──────────────────────
  vqsPostEcMedian     Float?  // Weighted avg earning capacity (post-injury viable)
  vqsPreEcMedian      Float?  // Weighted avg earning capacity (pre-injury viable)
  vqsEcLoss           Float?  // Earning capacity loss (pre - post) $/hr
  vqsEcLossPct        Float?  // Earning capacity loss as percentage

  // ─── Comprehensive Analysis Results ──────────────────────
  nearMissAnalysis     Json?   // Near-miss/retrainability analysis results
  rfcNarrative         Json?   // Residual Functional Capacity narrative
  viableSetAnalysis    Json?   // Viable set coherence/clustering analysis
  confidenceExplanation Json?  // Detailed confidence grade breakdown
  regionalLaborMarket  Json?   // Regional labor market context narrative
  hiredJobsAnalysis    Json?   // DEPRECATED: Not currently populated by compute. Retained for schema compatibility.
  laborMarketAccess    Json?   // Full labor market access analysis (all 831 OEWS occupations)
  zeroViableExplanation Json?  // Explanation when zero occupations survive filtering
  cpcAnalysis          Json?  // Component Profile Code analysis (worker profile, similar occs, gap analysis)

  case              Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  targetOccupations TargetOccupation[]

  @@index([caseId])
}

model TargetOccupation {
  id              String  @id @default(cuid())
  analysisId      String
  onetSocCode     String
  dotCode         String?
  title           String
  svp             Int?
  stq             Float?
  stqDetails      Json?
  tfq             Float?
  tfqDetails      Json?
  vaq             Float?
  vaqDetails      Json?
  lmq             Float?
  lmqDetails      Json?
  pvq             Float?
  excluded        Boolean @default(false)
  exclusionReason String?
  confidenceGrade        String?
  notes                  String?
  pendingEvaluatorReview Boolean? @default(false) // VAQ auto-estimated, needs evaluator confirmation
  hasTolerations         Boolean? @default(false) // clinical mode: marginal trait failures tolerated

  preTfq                 Float?
  preTfqPasses           Boolean?
  preTfqDetails          Json?
  joltsIndustryCode      String?
  joltsIndustryName      String?
  joltsCurrentOpenings   Float?   // current year openings (thousands)
  joltsPreInjuryOpenings Float?   // injury year openings (thousands)
  joltsTrend             Float?   // trend score (-1 to +1, from linear regression)
  joltsTrendLabel        String?  // "strongly_growing"|"growing"|"stable"|"declining"|"strongly_declining"

  // ─── Area-Level Employment ────────────────────────────────────
  areaEmployment         Int?     // employment count in evaluee's metro area
  areaMedianWage         Float?   // median wage in evaluee's metro area

  // ─── Local Demand (ZIP market composite) ────────────────────
  localDemandScore       Float?   // 0-100 composite from postings, structural, hiring momentum
  localDemandDetails     Json?    // full LocalDemandResult breakdown

  // ─── VQS: Vocational Quotient ─────────────────────────────
  vqScore        Float?   // VQS VQ score (68-158 scale, mean=100, SD=15)
  vqBand         Int?     // VQ Band (1-4)
  vqDetails      Json?    // Full VQ computation breakdown

  // ─── VQS: Transferable Skills Percent ─────────────────────
  tspScore       Float?   // TSP score (0-97%)
  tspTier        Int?     // TSP Tier (1-5)
  tspLabel       String?  // Qualitative label
  tspDetails     Json?    // Full TSP computation breakdown

  // ─── VQS: Earning Capacity ────────────────────────────────
  ecMedian       Float?   // Earning capacity median $/hr
  ecMean         Float?   // Earning capacity mean $/hr
  ec10           Float?   // 10th percentile $/hr
  ec25           Float?   // 25th percentile $/hr
  ec75           Float?   // 75th percentile $/hr
  ec90           Float?   // 90th percentile $/hr
  ecSee          Float?   // Standard Error of Estimate $/hr
  ecConfLow      Float?   // Lower 95% CI (median)
  ecConfHigh     Float?   // Upper 95% CI (median)
  ecGeoAdjusted  Boolean? // Whether ECLR geographic adjustment applied
  ecDetails      Json?    // Full EC breakdown

  // ─── VQS: Pre-Injury ─────────────────────────────────────
  preVqScore     Float?   // Pre-injury VQ (occupation-based, same as post)
  preEcMedian    Float?   // Pre-injury earning capacity median
  preEcDetails   Json?

  // ─── Component Profile Code ───────────────────────────────
  cpcCode            String?  // Human-readable CPC code (e.g., K[Admin+Econ]-S[CritThink+Judge]-...)
  cpcSimilarity      Float?   // Cosine similarity to worker composite (0-1)

  // ─── Near-Miss / Retrainability ────────────────────────────
  nearMissSeverity   String?  // "marginal" | "moderate" | "significant" | null (if viable)
  nearMissDetails    Json?    // detailed near-miss analysis for excluded occupations

  // ─── Trait Margin Details (for viable occupations) ─────────
  traitMarginMin     Float?   // minimum trait margin (closest to failing)
  traitMarginAvg     Float?   // average trait margin across all rated traits
  closestFailTrait   String?  // trait name that is closest to failing

  // ─── VQ-Centric Feasibility (replaces binary exclusion) ────
  feasibilityScore   Float?   // Continuous 0-100 feasibility score (VQ-weighted trait assessment)
  riskLevel          String?  // "none" | "marginal" | "moderate" | "severe"
  traitDeficits      Json?    // Array of {trait, label, deficit, vqWeight, penalty}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  onetOcc  OccupationONET @relation(fields: [onetSocCode], references: [id])

  @@index([analysisId])
  @@index([onetSocCode])
}

model DataSyncLog {
  id             String    @id @default(cuid())
  source         String
  status         String
  recordsUpdated Int       @default(0)
  version        String?
  error          String?
  startedAt      DateTime
  completedAt    DateTime?
}

// RHAJ Reference Data — structured definitions from the
// Revised Handbook for Analyzing Jobs (DOL, 1991)
model RHAJReference {
  id          String   @id // e.g. "dpt", "ged", "svp", "aptitudes", "temperaments", "physical_demands", "env_conditions", "work_fields", "mpsms"
  category    String   // chapter/topic category
  title       String   // human-readable title
  data        Json     // structured definitions from the RHAJ chapter
  source      String?  // source citation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
